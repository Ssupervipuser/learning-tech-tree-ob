{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Learning Tech Tree v1",
  "type":"object",
  "required":["format","id","title","stages","branches","sources","nodes","applicationEdges","startId","endId"],
  "properties":{
    "format":{"const":"learning-tech-tree/v1"},
    "id":{"$ref":"#/$defs/id"},
    "title":{"type":"string","minLength":1},
    "subtitle":{"type":"string"},
    "description":{"type":"string"},
    "version":{"type":"string"},
    "language":{"type":"string"},
    "education":{"type":"object","properties":{"path":{"type":"string"},"duration":{"type":["string","number","null"]},"note":{"type":"string"}}},
    "stages":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "branches":{"type":"array","minItems":1,"items":{"type":"object","required":["id","label","color"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string"},"en":{"type":"string"},"color":{"type":"string","pattern":"^#[a-fA-F0-9]{6}$"}}},
    "sources":{"type":"array","items":{"type":"object","required":["id","title","url","scope"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string"},"url":{"type":"string","pattern":"^(https?://.*)?$"},"scope":{"type":"string"}}}},
    "startId":{"$ref":"#/$defs/id"},
    "endId":{"$ref":"#/$defs/id"},
    "nodes":{"type":"array","minItems":2,"maxItems":2500,"items":{"type":"object","required":["id","name","branch","stage","kind","prereqIds","relatedIds","description","outcome","caution","sourceIds"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1},"branch":{"$ref":"#/$defs/id"},"stage":{"type":"integer","minimum":0},"kind":{"enum":["core","optional","milestone"]},"prereqIds":{"$ref":"#/$defs/idList"},"relatedIds":{"$ref":"#/$defs/idList"},"description":{"type":"string"},"outcome":{"type":"string","minLength":1},"caution":{"type":"string"},"sourceIds":{"$ref":"#/$defs/idList"}},"not":{"anyOf":[{"required":["notes"]},{"required":["completedOn"]}]}}},
    "applicationEdges":{"type":"array","items":{"type":"object","required":["source","target","relation","reason"],"properties":{"source":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/id"},"relation":{"enum":["development","application"]},"reason":{"type":"string","minLength":1}}}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,95}$","not":{"enum":["prototype","constructor","toString","valueOf","hasOwnProperty","isPrototypeOf","propertyIsEnumerable","toLocaleString"]}},
    "idList":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}}
  },
  "$comment":"Cross-reference integrity, stage bounds, combined-graph acyclicity, and start/end reachability are enforced by src/engine.cjs and scripts/validate.mjs. Stage count, branch names and degree duration are not fixed."
}
